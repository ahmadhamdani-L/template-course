{
  "schemaVersion": "1.0",
  "appKey": "docker_mastery",
  "identity": {
    "displayName": "Docker Mastery",
    "shortName": "Docker",
    "subtitle": "Container Technology from Zero to Hero",
    "description": "Master Docker containerization, compose, swarm, and Kubernetes. Build and deploy containerized applications with confidence.",
    "publisher": {
      "name": "Tech Education Platform",
      "website": "https://example.com",
      "supportEmail": "support@example.com",
      "privacyPolicyUrl": "https://example.com/privacy",
      "termsOfServiceUrl": "https://example.com/terms"
    },
    "version": "1.0.0",
    "buildNumber": 1
  },
  "branding": {
    "preset": "docker_cyan",
    "colors": {
      "primary": "#2496ED",
      "secondary": "#1D63ED",
      "accent": "#00B4D8",
      "success": "#06D6A0",
      "warning": "#FFB703",
      "error": "#EF476F"
    },
    "typography": {
      "fontFamily": "Inter",
      "codeFontFamily": "monospace",
      "fontSizeScale": 1.0,
      "lineHeightScale": 1.5
    },
    "spacing": {
      "xs": 4.0,
      "sm": 8.0,
      "md": 16.0,
      "lg": 24.0,
      "xl": 32.0,
      "xxl": 48.0
    },
    "borderRadius": {
      "sm": 6.0,
      "md": 10.0,
      "lg": 14.0,
      "xl": 18.0,
      "xxl": 24.0
    },
    "assets": {
      "logo": "assets/branding/docker_logo.png",
      "logoDark": "assets/branding/docker_logo_dark.png",
      "icon": "assets/branding/docker_icon.png"
    }
  },
  "navigation": {
    "type": "bottom_nav",
    "destinations": [
      {
        "id": "home",
        "labelKey": "home",
        "icon": "home",
        "route": "/",
        "enabled": true
      },
      {
        "id": "courses",
        "labelKey": "courses",
        "icon": "library",
        "route": "/courses",
        "enabled": true
      },
      {
        "id": "profile",
        "labelKey": "profile",
        "icon": "person",
        "route": "/profile",
        "enabled": true
      }
    ],
    "dashboard": {
      "sections": [
        {
          "id": "continue_learning",
          "type": "continue_learning",
          "titleKey": "continue_learning",
          "maxItems": 2,
          "displayStyle": "list",
          "enabled": true,
          "order": 1
        },
        {
          "id": "recommended_courses",
          "type": "recommended_courses",
          "titleKey": "recommended_courses",
          "maxItems": 4,
          "displayStyle": "grid",
          "navigationRoute": "/courses",
          "enabled": true,
          "order": 2
        },
        {
          "id": "weekly_progress",
          "type": "weekly_progress",
          "titleKey": "weekly_progress",
          "maxItems": 1,
          "displayStyle": "card",
          "enabled": true,
          "order": 3
        }
      ],
      "enableSearch": true,
      "showWelcomeHeader": true
    },
    "initialRoute": "/",
    "enableOnboarding": false
  },
  "features": {
    "courseCatalog": true,
    "lessonReader": true,
    "quizEngine": true,
    "progressTracking": true,
    "learningPaths": true,
    "bookmarks": true,
    "notes": true,
    "search": true,
    "assessments": true,
    "flashcards": true,
    "spacedRepetition": false,
    "interactiveExercises": false,
    "codePlayground": false,
    "learningHistory": true,
    "achievements": false,
    "learningStreaks": false,
    "dailyChallenges": false,
    "certificates": true,
    "offlineMode": true,
    "downloads": true,
    "cloudSync": false,
    "userAccounts": false,
    "socialSharing": false,
    "recommendations": true,
    "contentRating": true,
    "themeSwitcher": true,
    "fontSizeAdjustment": true,
    "languageSwitcher": true,
    "premiumFeatures": false,
    "advertisements": false,
    "helpCenter": true,
    "feedback": true,
    "analytics": false,
    "crashReporting": false,
    "pushNotifications": false,
    "reminderNotifications": false
  },
  "localization": {
    "defaultLocale": "en",
    "supportedLocales": ["en", "id"],
    "fallbackLocale": "en",
    "showLanguageSwitcher": true
  },
  "content": {
    "bundledEnabled": true,
    "remoteEnabled": false,
    "contentVersion": "1.0.0",
    "updateCheckIntervalHours": 24
  }
}
